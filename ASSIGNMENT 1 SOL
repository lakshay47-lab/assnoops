//q8
#include <iostream>
using namespace std;

int main() {
    int days;
    float fine = 0;

    cout << "Enter number of days late: ";
    cin >> days;

    if (days <= 5) {
        fine = days * 0.50;
        cout << "Fine = Rs " << fine << endl;
    }
    else if (days <= 10) {
        fine = (5 * 0.50) + (days - 5) * 1.0;
        cout << "Fine = Rs " << fine << endl;
    }
    else if (days <= 30) {
        fine = (5 * 0.50) + (5 * 1.0) + (days - 10) * 5.0;
        cout << "Fine = Rs " << fine << endl;
    }
    else {
        cout << "Membership cancelled!" << endl;
    }

    return 0;
}

//q9
#include <iostream>
using namespace std;

int main() {
    int a, b, choice;

    cout << "Enter two numbers: ";
    cin >> a >> b;

    cout << "Menu";
    cout << "\n1. Addition";
    cout << "\n2. Subtraction";
    cout << "\n3. Multiplication";
    cout << "\n4. Division";
    cout << "Enter your choice: ";
    cin >> choice;

    switch (choice) {
        case 1:
            cout << "Addition = " << a + b;
            break;

        case 2:
            cout << "Subtraction = " << a - b;
            break;

        case 3:
            cout << "Multiplication = " << a * b;
            break;

        case 4:
            if (b != 0)
                cout << "Division = " << (float)a / b;
            else
                cout << " not possible ";
            break;

        default:
            cout << "Invalid ";
    }

    return 0;
}

